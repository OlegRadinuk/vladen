# Claude AI (прямой Anthropic API)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Telegram бот для заявок
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# Безопасность: только запросы с этого домена
ALLOWED_ORIGIN=https://vladen-crimea.ru

# Автоблог — движок статей (серверные переменные, без NEXT_PUBLIC)
# URL движка, например: https://blog-engine.optisphere.tech
BLOG_API_URL=
# Bearer-токен сайта «vladen» из таблицы sites.api_token движка
BLOG_API_TOKEN=
# Секрет для POST /api/revalidate (вебхук от движка)
BLOG_REVALIDATE_SECRET=

# Резервный журнал заявок (JSONL, ПД → файл 0600). Абсолютный путь ВНЕ .next/standalone.
# По умолчанию: /var/www/vladen/data/leads.jsonl (prod), ./data/leads.jsonl (dev)
LEADS_LOG_PATH=

# База Telegram API (реле из РФ), без завершающего слеша и без /bot. По умолчанию tg-proxy workers.dev
TELEGRAM_API_BASE=
